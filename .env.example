# Copy this file to .env and uncomment what you need.
# .env is gitignored: never commit it.

# Font for all on-screen text (absolute path, or relative to the project folder).
# Default: the first .ttf/.otf in assets/fonts/, then a system monospace font.
# STATICREELS_FONT=assets/fonts/MyFont.ttf

# Full paths to ffmpeg / ffprobe, only needed if they aren't on PATH.
# STATICREELS_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# STATICREELS_FFPROBE=C:/ffmpeg/bin/ffprobe.exe

# Future AI-clip providers or schedulers will read their API keys from here.
# None are implemented yet, so nothing below is used.
# KLING_API_KEY=
# AYRSHARE_API_KEY=
